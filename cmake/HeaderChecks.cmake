file(GLOB_RECURSE arcade_headers CONFIGURE_DEPENDS
    "${PROJECT_SOURCE_DIR}/include/*.hpp" "${PROJECT_SOURCE_DIR}/src/*.hpp"
    "${PROJECT_SOURCE_DIR}/bonus/*.hpp" "${PROJECT_SOURCE_DIR}/tests/*.hpp")
get_property(extra_folders GLOBAL PROPERTY ARCADE_EXTRA_FOLDERS)
set(header_sources)
foreach(header IN LISTS arcade_headers)
    if(header MATCHES "/tests/legacy/original/" OR header MATCHES "/bonus/legacy/sdk/")
        continue()
    endif()
    if(NOT ARCADE_BUILD_GRAPHICS AND header MATCHES "/src/graphics/")
        continue()
    endif()
    file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${header}")
    if(relative MATCHES "^bonus/graphics/([^/]+)/")
        if(NOT CMAKE_MATCH_1 IN_LIST extra_folders)
            continue()
        endif()
    endif()
    string(MAKE_C_IDENTIFIER "${relative}" key)
    set(source "${CMAKE_BINARY_DIR}/header-checks/${key}.cpp")
    file(GENERATE OUTPUT "${source}" CONTENT "#include \"${header}\"\n")
    list(APPEND header_sources "${source}")
endforeach()
add_library(header_checks OBJECT ${header_sources})
target_include_directories(header_checks PRIVATE "${PROJECT_SOURCE_DIR}/src/games/snake"
    "${PROJECT_SOURCE_DIR}/src/games/minesweeper")
target_link_libraries(header_checks PRIVATE arcade_sdk)
if(ARCADE_BUILD_GRAPHICS)
    target_include_directories(header_checks PRIVATE ${CURSES_INCLUDE_DIRS})
    target_link_libraries(header_checks PRIVATE PkgConfig::SDL2 PkgConfig::SFML)
endif()

if(TARGET arcade_extra_header_dependencies)
    target_link_libraries(header_checks PRIVATE arcade_extra_header_dependencies)
endif()
